    def calculate_differences(self, results1, results2):
        # Create dict mapping original ud_line to match data for each scenario
        # Using original ud_line as key since that's what we want to compare
        matches1_by_ud = {self.normalize_string(m['ud_original']): m for m in results1['matches']}
        matches2_by_ud = {self.normalize_string(m['ud_original']): m for m in results2['matches']}
        
        # Find differences based on original ud_files lines
        only_in_1_keys = set(matches1_by_ud.keys()) - set(matches2_by_ud.keys())
        only_in_2_keys = set(matches2_by_ud.keys()) - set(matches1_by_ud.keys())
        in_both_keys = set(matches1_by_ud.keys()) & set(matches2_by_ud.keys())
        
        # Get full data for differences
        only_in_1 = [matches1_by_ud[k] for k in only_in_1_keys]
        only_in_2 = [matches2_by_ud[k] for k in only_in_2_keys]
        in_both = [matches1_by_ud[k] for k in in_both_keys]
        
        self.log(f"  Only in Scenario 1: {len(only_in_1):,}")
        self.log(f"  Only in Scenario 2: {len(only_in_2):,}")
        self.log(f"  In both: {len(in_both):,}")
        
        return {
            'only_in_1': only_in_1,
            'only_in_2': only_in_2,
            'in_both': in_both
        }
    
    def create_single_excel(self, results, method, n_chars=5):
        wb = Workbook()
        if 'Sheet' in wb.sheetnames:
            wb.remove(wb['Sheet'])
        
        self.log("\nCreating Excel report...")
        
        # Styling
        h_blue = PatternFill(start_color="366092", end_color="366092", fill_type="solid")
        h_green = PatternFill(start_color="00B050", end_color="00B050", fill_type="solid")
        h_orange = PatternFill(start_color="FFA500", end_color="FFA500", fill_type="solid")
        h_red = PatternFill(start_color="FF0000", end_color="FF0000", fill_type="solid")
        h_gray = PatternFill(start_color="808080", end_color="808080", fill_type="solid")
        h_font = Font(bold=True, color="FFFFFF")
        
        method_name = "Filename only" if method == "filename_only" else f"{n_chars} chars + filename"
        
        # SUMMARY
        s = wb.create_sheet("SUMMARY", 0)
        s['A1'] = f"UD FILES HSM COMPARISON - {method_name}"
        s['A1'].font = Font(bold=True, size=14)
        s.merge_cells('A1:C1')
        
        row = 3
        s[f'A{row}'] = "ud_files entries:"; s[f'B{row}'] = results['ud_total']; row += 1
        s[f'A{row}'] = "HSM entries:"; s[f'B{row}'] = results['hsm_total']; row += 1
        s[f'A{row}'] = "Excluded (drwx):"; s[f'B{row}'] = len(results['drwx_entries']); row += 2
        
        s[f'A{row}'] = "Found in HSM:"; s[f'B{row}'] = len(results['matches'])
        s[f'B{row}'].fill = PatternFill(start_color="C6EFCE", end_color="C6EFCE", fill_type="solid"); row += 1
        
        s[f'A{row}'] = "bg-ingest:"; s[f'B{row}'] = len(results['bg_ingest_matches'])
        s[f'B{row}'].fill = PatternFill(start_color="FFEB9C", end_color="FFEB9C", fill_type="solid"); row += 1
        
        s[f'A{row}'] = "Not in HSM:"; s[f'B{row}'] = len(results['unique'])
        s[f'B{row}'].fill = PatternFill(start_color="FFC7CE", end_color="FFC7CE", fill_type="solid")
        
        s.column_dimensions['A'].width = 25; s.column_dimensions['B'].width = 15
        
        # MATCHES
        self._create_matches_sheet(wb, "FOUND IN HSM", results['matches'], h_green, h_font)
        
        # BG-INGEST
        if results['bg_ingest_matches']:
            self._create_matches_sheet(wb, "BG-INGEST", results['bg_ingest_matches'], h_orange, h_font)
        
        # UNIQUE
        s = wb.create_sheet("NOT IN HSM")
        s.cell(1, 1, "Extracted").fill = h_red; s.cell(1, 1).font = h_font
        s.cell(1, 2, "ud_files Full Line").fill = h_red; s.cell(1, 2).font = h_font
        for i, u in enumerate(results['unique'], 2):
            s.cell(i, 1, u['filename']); s.cell(i, 2, u['ud_line'])
        s.column_dimensions['A'].width = 50; s.column_dimensions['B'].width = 80
        
        # DRWX
        if results['drwx_entries']:
            s = wb.create_sheet("EXCLUDED DRWX")
            s.cell(1, 1, "Full Line (Directory)").fill = h_gray; s.cell(1, 1).font = h_font
            for i, line in enumerate(results['drwx_entries'], 2):
                s.cell(i, 1, line)
            s.column_dimensions['A'].width = 100
        
        output_file = os.path.join(os.path.dirname(self.ud_files_path), "UD_HSM_Comparison_Single.xlsx")
        wb.save(output_file)
        return output_file
    
    def _create_matches_sheet(self, wb, name, matches, fill, font):
        s = wb.create_sheet(name)
        headers = ["ud Extracted", "HSM Extracted", "ud Full Line", "HSM Full Line"]
        for col, h in enumerate(headers, 1):
            c = s.cell(1, col, h); c.fill = fill; c.font = font
        for i, m in enumerate(matches, 2):
            s.cell(i, 1, m['ud_filename']); s.cell(i, 2, m['hsm_filename'])
            s.cell(i, 3, m['ud_line']); s.cell(i, 4, m['hsm_line'])
        s.column_dimensions['A'].width = 50; s.column_dimensions['B'].width = 50
        s.column_dimensions['C'].width = 80; s.column_dimensions['D'].width = 80
    
    def create_dual_excel(self, r1, r2, diff, method1, method2, n_chars1=5, n_chars2=5):
        wb = Workbook()
        if 'Sheet' in wb.sheetnames:
            wb.remove(wb['Sheet'])
        
        self.log("\nCreating Excel report...")
        
        h_blue = PatternFill(start_color="366092", end_color="366092", fill_type="solid")
        h_green = PatternFill(start_color="00B050", end_color="00B050", fill_type="solid")
        h_orange = PatternFill(start_color="FFA500", end_color="FFA500", fill_type="solid")
        h_red = PatternFill(start_color="FF0000", end_color="FF0000", fill_type="solid")
        h_purple = PatternFill(start_color="9966FF", end_color="9966FF", fill_type="solid")
        h_gray = PatternFill(start_color="808080", end_color="808080", fill_type="solid")
        h_font = Font(bold=True, color="FFFFFF")
        
        name1 = "Filename only" if method1 == "filename_only" else f"{n_chars1} chars + filename"
        name2 = "Filename only" if method2 == "filename_only" else f"{n_chars2} chars + filename"
        
        # SUMMARY
        s = wb.create_sheet("SUMMARY", 0)
        s['A1'] = "DUAL SCENARIO COMPARISON"
        s['A1'].font = Font(bold=True, size=16)
        s.merge_cells('A1:C1')
        
        row = 3
        s[f'A{row}'] = "Scenario 1:"; s[f'B{row}'] = name1; s[f'A{row}'].font = Font(bold=True, size=12); row += 1
        s[f'A{row}'] = "  Matches:"; s[f'B{row}'] = len(r1['matches'])
        s[f'B{row}'].fill = PatternFill(start_color="C6EFCE", end_color="C6EFCE", fill_type="solid"); row += 1
        s[f'A{row}'] = "  bg-ingest:"; s[f'B{row}'] = len(r1['bg_ingest_matches']); row += 1
        s[f'A{row}'] = "  Unique:"; s[f'B{row}'] = len(r1['unique']); row += 2
        
        s[f'A{row}'] = "Scenario 2:"; s[f'B{row}'] = name2; s[f'A{row}'].font = Font(bold=True, size=12); row += 1
        s[f'A{row}'] = "  Matches:"; s[f'B{row}'] = len(r2['matches'])
        s[f'B{row}'].fill = PatternFill(start_color="C6EFCE", end_color="C6EFCE", fill_type="solid"); row += 1
        s[f'A{row}'] = "  bg-ingest:"; s[f'B{row}'] = len(r2['bg_ingest_matches']); row += 1
        s[f'A{row}'] = "  Unique:"; s[f'B{row}'] = len(r2['unique']); row += 2
        
        s[f'A{row}'] = "Differences:"; s[f'A{row}'].font = Font(bold=True, size=12); row += 1
        s[f'A{row}'] = "  Only in S1:"; s[f'B{row}'] = len(diff['only_in_1'])
        s[f'B{row}'].fill = PatternFill(start_color="FFD9B3", end_color="FFD9B3", fill_type="solid"); row += 1
        s[f'A{row}'] = "  Only in S2:"; s[f'B{row}'] = len(diff['only_in_2'])
        s[f'B{row}'].fill = PatternFill(start_color="D9B3FF", end_color="D9B3FF", fill_type="solid"); row += 1
        s[f'A{row}'] = "  In both:"; s[f'B{row}'] = len(diff['in_both'])
        s[f'B{row}'].fill = PatternFill(start_color="B3D9FF", end_color="B3D9FF", fill_type="solid")
        
        s.column_dimensions['A'].width = 25; s.column_dimensions['B'].width = 20
        
        # Scenario 1 sheets
        self._create_matches_sheet(wb, "S1 - FOUND IN HSM", r1['matches'], h_green, h_font)
        if r1['bg_ingest_matches']:
            self._create_matches_sheet(wb, "S1 - BG-INGEST", r1['bg_ingest_matches'], h_orange, h_font)
        self._create_unique_sheet(wb, "S1 - NOT IN HSM", r1['unique'], h_red, h_font)
        
        # Scenario 2 sheets
        self._create_matches_sheet(wb, "S2 - FOUND IN HSM", r2['matches'], h_green, h_font)
        if r2['bg_ingest_matches']:
            self._create_matches_sheet(wb, "S2 - BG-INGEST", r2['bg_ingest_matches'], h_orange, h_font)
        self._create_unique_sheet(wb, "S2 - NOT IN HSM", r2['unique'], h_red, h_font)
        
        # Differences
        self._create_matches_sheet(wb, "DIFF - Only in S1", diff['only_in_1'], h_orange, h_font)
        self._create_matches_sheet(wb, "DIFF - Only in S2", diff['only_in_2'], h_purple, h_font)
        self._create_matches_sheet(wb, "DIFF - In Both", diff['in_both'], h_blue, h_font)
        
        # DRWX (same for both scenarios)
        if r1['drwx_entries']:
            s = wb.create_sheet("EXCLUDED DRWX")
            s.cell(1, 1, "Full Line").fill = h_gray; s.cell(1, 1).font = h_font
            for i, line in enumerate(r1['drwx_entries'], 2):
                s.cell(i, 1, line)
            s.column_dimensions['A'].width = 100
        
        output_file = os.path.join(os.path.dirname(self.ud_files_path), "UD_HSM_Comparison_Dual.xlsx")
        wb.save(output_file)
        return output_file
    
    def _create_unique_sheet(self, wb, name, unique, fill, font):
        s = wb.create_sheet(name)
        s.cell(1, 1, "Extracted").fill = fill; s.cell(1, 1).font = font
        s.cell(1, 2, "ud Full Line").fill = fill; s.cell(1, 2).font = font
        for i, u in enumerate(unique, 2):
            s.cell(i, 1, u['filename']); s.cell(i, 2, u['ud_line'])
        s.column_dimensions['A'].width = 50; s.column_dimensions['B'].width = 80


