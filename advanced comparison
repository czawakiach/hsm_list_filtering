    def run_comparison_scenario(self, extraction_method, label, n_chars=5):
        # Load HSM
        self.log(f"Loading HSM file...")
        hsm_entries = []
        with open(self.hsm_file_path, 'r', encoding='utf-8') as f:
            for line_num, line in enumerate(f, 1):
                line = line.strip()
                if line:
                    filename = self.extract_filename(line, extraction_method, n_chars)
                    if filename:
                        normalized = self.normalize_string(filename)
                        hsm_entries.append((line, filename, normalized))
                if line_num % 100000 == 0:
                    self.log(f"  HSM: {line_num:,} lines...")
        
        self.log(f"✓ HSM: {len(hsm_entries):,} entries")
        
        # Load ud_files
        self.log(f"Loading ud_files.lst...")
        ud_entries = []
        drwx_entries = []
        with open(self.ud_files_path, 'r', encoding='utf-8') as f:
            for line_num, line in enumerate(f, 1):
                line = line.strip()
                if line:
                    if line.startswith('drwx'):
                        drwx_entries.append(line)
                        continue
                    filename = self.extract_filename(line, extraction_method, n_chars)
                    if filename:
                        normalized = self.normalize_string(filename)
                        ud_entries.append((line, filename, normalized))
                if line_num % 100000 == 0:
                    self.log(f"  ud_files: {line_num:,} lines...")
        
        self.log(f"✓ ud_files: {len(ud_entries):,} entries")
        if drwx_entries:
            self.log(f"  Excluded {len(drwx_entries):,} drwx entries")
        
        # Build HSM index
        hsm_index = self.build_hash_index(hsm_entries, "HSM")
        
        # Compare
        self.log("Comparing...")
        matches = []
        bg_ingest_matches = []
        unique = []
        
        for idx, (ud_line, ud_filename, ud_normalized) in enumerate(ud_entries, 1):
            if ud_normalized in hsm_index:
                hsm_line, hsm_filename = hsm_index[ud_normalized]
                match_data = {
                    'ud_filename': ud_filename,
                    'ud_line': ud_line,
                    'hsm_filename': hsm_filename,
                    'hsm_line': hsm_line,
                    'normalized': ud_normalized,
                    'ud_original': ud_line,  # Store original for dual comparison
                    'hsm_original': hsm_line  # Store original for dual comparison
                }
                
                if 'bg-ingest' in ud_line.lower():
