    def log(self, message):
        self.status_text.insert(tk.END, message + "\n")
        self.status_text.see(tk.END)
        self.status_text.update()
    
    def start_comparison(self):
        self.compare_button.config(state=tk.DISABLED)
        self.status_text.delete(1.0, tk.END)
        self.progress.start()
        thread = threading.Thread(target=self.compare_files)
        thread.start()
    
    def normalize_string(self, s):
        return ''.join(s.upper().split())
    
    def extract_filename(self, line, method, n_chars=5):
        if '/' not in line:
            return None
        
        if method == 'filename_only':
            return line.rsplit('/', 1)[-1].strip()
        elif method == 'n_chars':
            before_slash, after_slash = line.rsplit('/', 1)
            last_n_chars = before_slash[-n_chars:] if len(before_slash) >= n_chars else before_slash
            return f"{last_n_chars}/{after_slash.strip()}"
        return None
    
    def build_hash_index(self, entries, name):
        self.log(f"Building hash index for {name}...")
        hash_index = {}
        for orig_line, filename, norm_filename in entries:
            if norm_filename not in hash_index:
                hash_index[norm_filename] = (orig_line, filename)
        self.log(f"✓ Index complete: {len(hash_index):,} unique filenames\n")
        return hash_index
    
    def compare_files(self):
        try:
            mode = self.mode_var.get()
            
            if mode == "single":
                self.compare_single_scenario()
            else:
                self.compare_dual_scenarios()
                
        except Exception as e:
            self.log(f"\nERROR: {str(e)}")
            import traceback
            self.log(traceback.format_exc())
            messagebox.showerror("Error", f"An error occurred:\n{str(e)}")
        finally:
            self.progress.stop()
            self.compare_button.config(state=tk.NORMAL)
    
    def compare_single_scenario(self):
        extraction_method = self.extraction_var.get()
        n_chars = int(self.single_chars_var.get()) if extraction_method == 'n_chars' else 5
        method_name = "Filename only" if extraction_method == "filename_only" else f"{n_chars} chars + filename"
        
        self.log("="*70)
        self.log("SINGLE SCENARIO COMPARISON")
        self.log(f"Method: {method_name}")
        self.log("="*70)
        
        results = self.run_comparison_scenario(extraction_method, "", n_chars)
        
        output_file = self.create_single_excel(results, extraction_method, n_chars)
        
        match_rate = (len(results['matches']) / results['ud_total'] * 100) if results['ud_total'] > 0 else 0
        
        self.log(f"\n{'='*70}")
        self.log("SUMMARY")
        self.log(f"{'='*70}")
        self.log(f"Method: {method_name}")
        self.log(f"ud_files: {results['ud_total']:,} | HSM: {results['hsm_total']:,} | Excluded (drwx): {len(results['drwx_entries']):,}")
        self.log(f"Found in HSM: {len(results['matches']):,} ({match_rate:.1f}%)")
        self.log(f"bg-ingest: {len(results['bg_ingest_matches']):,} | Not in HSM: {len(results['unique']):,}")
        self.log(f"\nReport: {os.path.basename(output_file)}")
        
        messagebox.showinfo("Success", 
            f"Comparison complete!\n\n"
            f"Method: {method_name}\n"
            f"Found in HSM: {len(results['matches']):,} ({match_rate:.1f}%)\n"
            f"Not in HSM: {len(results['unique']):,}\n\n"
            f"Report saved!")
    
